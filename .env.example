APP_NAME=FluxMoneva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=1440
# AUTH3-01 (session navigateur Sanctum SPA). En local, garder « localhost »
# partout (front http://localhost:5173, API http://localhost:8000).
# En production (domaine partagé app.<domaine> / api.<domaine>) :
# SESSION_DOMAIN=.<domaine>
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=app.<domaine>

# LWS-BE-06C — worker de file unique (deploy/lws/QUEUE-WORKER-RUNBOOK.md).
# Chemins ABSOLUS dans la racine privée, hors de l'application et des racines
# publiques, sans valeur par défaut : vides, ops:queue-* refusent de démarrer
# (code 2). Verrou/garde et journaux dans des dossiers distincts. Production :
#   QUEUE_WORKER_OPS_ROOT=/home/fluxmoneva-ops
#   QUEUE_WORKER_PUBLIC_ROOTS=/home/htdocs
#   /home/fluxmoneva-ops/queue/worker.lock   /home/fluxmoneva-ops/queue/paused
#   /home/fluxmoneva-ops/logs/queue-worker.log
#   /home/fluxmoneva-ops/logs/cron-output.log
QUEUE_WORKER_OPS_ROOT=
QUEUE_WORKER_PUBLIC_ROOTS=
QUEUE_WORKER_LOCK_PATH=
QUEUE_WORKER_PAUSE_PATH=
QUEUE_WORKER_LOG_PATH=
QUEUE_WORKER_CRON_OUTPUT_PATH=
# Paramètres PROVISOIRES, fixés par LWS-BE-06D (aucune valeur par défaut).
# Candidats à répéter : MAX_TIME=50 TIMEOUT=45 SLEEP=1 MEMORY=128.
# Invariants : TIMEOUT < retry_after (connexion database, valeur courante)
# et MAX_TIME + TIMEOUT <= RUNTIME_BUDGET.
QUEUE_WORKER_MAX_TIME=
QUEUE_WORKER_TIMEOUT=
QUEUE_WORKER_SLEEP=
QUEUE_WORKER_MEMORY=
QUEUE_WORKER_RUNTIME_BUDGET=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
