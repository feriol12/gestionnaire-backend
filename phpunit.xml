<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- SEC-AUTH-00, two-layer defense — this block is LAYER 1 only:
             force="true" makes PHPUnit set getenv()/$_ENV for these keys
             before the app boots, which gives safe defaults and overrides
             the common case (an unset value, or one that would otherwise
             come from .env). It is a defensive convenience, NOT a proven
             guarantee: PHPUnit's force="true" does not necessarily replace
             an already-populated $_SERVER entry, and Laravel/Dotenv may
             read $_SERVER before other environment sources in some paths.
             Do not rely on this block alone for safety.
             LAYER 2 (authoritative): tests/Support/TestDatabaseSafety,
             invoked from tests/CreatesApplication.php, independently
             re-validates Laravel's ACTUALLY RESOLVED configuration after
             the application has fully bootstrapped — regardless of which
             of these sources produced it — and refuses to let any test
             proceed if that resolved configuration is unsafe. That guard,
             not this env block, is what actually prevents an unsafe run. -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="gestionnaire_test" force="true"/>
        <env name="DATABASE_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
