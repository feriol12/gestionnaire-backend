# SEC-AUTH-00 — optional local test-database profile.
#
# You do NOT need this file to run `php artisan test` safely: phpunit.xml
# already sets APP_ENV=testing, DB_CONNECTION=mysql and
# DB_DATABASE=gestionnaire_test for every run (a defensive default, on top
# of whatever host/port/credentials your normal .env already has for local
# MySQL). The actual safety guarantee comes from
# tests/Support/TestDatabaseSafety.php, which independently re-checks
# Laravel's real resolved configuration after boot — whatever env file or
# shell variable produced it — and refuses to run if it is unsafe.
#
# Only copy this to a real .env.testing if your local test database needs a
# different host, port, or credentials than your regular development .env.
#
# If you do create .env.testing:
#   - Laravel REPLACES .env with it entirely when APP_ENV=testing (the two
#     files are not merged), so it must contain every value you need, not
#     just the database ones below.
#   - it is git-ignored (see .gitignore) and must never be committed.
#   - it must never point at gestionnaire_depense or any database name that
#     does not end in "_test" — tests/Support/TestDatabaseSafety.php will
#     refuse to run otherwise.

APP_ENV=testing
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestionnaire_test
DB_USERNAME=<local-user-placeholder>
DB_PASSWORD=<local-password-placeholder>
